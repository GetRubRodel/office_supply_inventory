# =============================================================================
#  Office Supply Inventory — Apache performance configuration
#  Requires: mod_rewrite, mod_headers, mod_deflate, mod_brotli, mod_expires,
#            mod_filter, mod_mime (all enabled in httpd.conf).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. MIME types for modern image formats (Apache may not know these by default)
# -----------------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/avif .avif
    AddType font/woff2 .woff2
</IfModule>

# -----------------------------------------------------------------------------
# 2. Compression — Brotli preferred, gzip fallback
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
    # If the client accepts Brotli, disable gzip so the response is not
    # double-compressed (mod_brotli handles it instead).
    SetEnvIfNoCase Accept-Encoding "br" no-gzip

    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE application/rss+xml application/ld+json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff font/woff2 application/font-woff
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
    AddOutputFilterByType BROTLI_COMPRESS text/javascript application/javascript
    AddOutputFilterByType BROTLI_COMPRESS application/json application/xml
    AddOutputFilterByType BROTLI_COMPRESS application/rss+xml application/ld+json
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
    AddOutputFilterByType BROTLI_COMPRESS font/woff font/woff2 application/font-woff
    AddOutputFilterByType BROTLI_COMPRESS application/vnd.ms-fontobject
</IfModule>

# -----------------------------------------------------------------------------
# 3. Cache-Control / Expires for static assets
#    HTML is intentionally NOT cached (dynamic, authenticated pages).
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                              "access plus 1 month"

    # Immutable, content-addressed or rarely-changing binary assets.
    ExpiresByType image/webp                    "access plus 1 year"
    ExpiresByType image/avif                    "access plus 1 year"
    ExpiresByType image/png                     "access plus 1 year"
    ExpiresByType image/jpeg                    "access plus 1 year"
    ExpiresByType image/gif                     "access plus 1 year"
    ExpiresByType image/svg+xml                 "access plus 1 year"
    ExpiresByType image/x-icon                  "access plus 1 year"
    ExpiresByType font/woff2                    "access plus 1 year"
    ExpiresByType font/woff                     "access plus 1 year"
    ExpiresByType font/ttf                      "access plus 1 year"
    ExpiresByType application/font-woff         "access plus 1 year"

    # Stylesheets / scripts (no content hash in Filament's published assets,
    # so a shorter window avoids stale files after an upgrade).
    ExpiresByType text/css                      "access plus 1 month"
    ExpiresByType application/javascript        "access plus 1 month"
    ExpiresByType text/javascript               "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    # Long-lived immutable caching for binary assets.
    <FilesMatch "\.(woff2?|ttf|eot|otf|png|jpe?g|gif|svg|webp|avif|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Vite build output is content-hashed — safe to cache forever.
    <FilesMatch "^build/.*\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Stylesheets / scripts.
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # Ensure caches key on the negotiated encoding.
    Header append Vary Accept-Encoding
</IfModule>

# -----------------------------------------------------------------------------
# 4. Laravel front-controller routing (unchanged)
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
